{
  "expo": {
    "name": "EFFEX Trade",
    "slug": "effex-trade",
    "scheme": "effextrade",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FEF7EB",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://effextrade.maisvida.cloud/api/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.effex.trade",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.effex.trade",
      "adaptiveIcon": {
        "backgroundColor": "#061D39",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#061D39"
        }
      ],
      [
        "expo-secure-store",
        {}
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O EFFEX Trade usa sua localização durante a jornada para registrar check-in nos clientes e mostrar sua posição ao supervisor.",
          "locationWhenInUsePermission": "O EFFEX Trade usa sua localização para validar o check-in no cliente (cerca eletrônica).",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "O EFFEX Trade usa sua localização durante a jornada para registrar check-in nos clientes e mostrar sua posição ao supervisor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O EFFEX Trade usa a câmera para registrar as fotos do atendimento (antes/depois, ruptura, vencimento).",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
