{
  "name": "@effex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "tsx scripts/dev-db.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "sharp@0.35.5": true
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
