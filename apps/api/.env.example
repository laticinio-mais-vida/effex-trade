DATABASE_URL="postgresql://postgres:postgres@localhost:5433/effex"
JWT_SECRET="troque-este-segredo-em-producao"
PORT=3333
UPLOAD_DIR="./uploads"
TZ_APP="America/Bahia"
# Servidor de rotas OSRM (distâncias pelas ruas). Vazio = distâncias em linha reta. Ver infra/osrm/README.md
OSRM_URL=""
# Chave da sincronização de clientes com o ERP (igual à do sync/config.ini). Vazio = sincronização desligada
SYNC_KEY=""
# Origens liberadas no CORS, separadas por vírgula. Vazio = qualquer origem (desenvolvimento)
CORS_ORIGIN=""
# true atrás de proxy (Caddy/nginx), para o limite de tentativas de login usar o IP real
TRUST_PROXY="false"
